<div id="loginPage" style="display:flex;justify-content:center;align-items:center;width:100%;min-height:100vh;background:linear-gradient(135deg,#0d47a1,#1565c0);position:fixed;top:0;left:0;z-index:9999;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;">
<div style="background:white;border-radius:20px;padding:40px 35px;max-width:400px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.3);text-align:center;">
